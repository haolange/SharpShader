<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<Platforms>AnyCPU</Platforms>
		<AssemblyName>SharpShader</AssemblyName>
		<RootNamespace>SharpShader</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>enable</Nullable>
		<WarningLevel>5</WarningLevel>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>Recommended</AnalysisMode>
	</PropertyGroup>

	<ItemGroup>
	</ItemGroup>


  <PropertyGroup><Version>$(StackPackageVersion)</Version><RepositoryUrl>https://github.com/haolange/SharpShader</RepositoryUrl></PropertyGroup>
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" Visible="false" />

    <None Include="../../native/assets.json" Pack="true" PackagePath="native/assets.json" />
    <Content Include="../../LICENSE" Pack="true" PackagePath="licenses/" Link="ThirdPartyNotices/SharpShader/LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/provenance/InfinityBrowser.LICENSE" Pack="true" PackagePath="licenses/InfinityBrowser.LICENSE" Link="ThirdPartyNotices/SharpShader/InfinityBrowser.LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../buildTransitive/SharpShader.targets" Pack="true" PackagePath="buildTransitive/SharpShader.targets" />
  </ItemGroup>
  <PropertyGroup><PackageLicenseExpression>MPL-2.0</PackageLicenseExpression></PropertyGroup>
  <Import Project="../../native/SharpShader.NativeAssets.props" />
  <Import Project="../../build/SharpShader.Core.props" />
</Project>
