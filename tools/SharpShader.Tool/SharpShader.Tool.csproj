<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SharpShader.Tool</AssemblyName>
    <RootNamespace>SharpShader.Tool</RootNamespace>
    <WarningLevel>5</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Runtime\Graphics\SharpShader\SharpShader.csproj" />
    <ProjectReference Include="..\..\Runtime\Graphics\SharpShader\CSharp\SharpShader.CSharp.csproj" />
  </ItemGroup>

</Project>
