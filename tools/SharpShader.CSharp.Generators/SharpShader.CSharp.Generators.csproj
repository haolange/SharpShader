<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Platforms>x64;ARM64</Platforms>
    <AssemblyName>SharpShader.CSharp.Generators</AssemblyName>
    <RootNamespace>SharpShader.CSharp.Generators</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>true</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <WarningLevel>5</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <NoWarn>$(NoWarn);RS2008;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharpShader/CSharp/Frontend/SharpShader.CSharp.Frontend.csproj" PrivateAssets="all" Condition="'$(StackReferenceMode)' == 'Source'" />
    <ProjectReference Include="../../src/SharpShader/CSharp/ShaderLib/SharpShader.CSharp.ShaderLib.csproj" PrivateAssets="all" Condition="'$(StackReferenceMode)' == 'Source'" />
    <PackageReference Include="SharpShader.CSharp.Frontend" Version="$(StackPackageVersion)" PrivateAssets="all" Condition="'$(StackReferenceMode)' == 'Package'" />
    <PackageReference Include="SharpShader.CSharp.ShaderLib" Version="$(StackPackageVersion)" PrivateAssets="all" Condition="'$(StackReferenceMode)' == 'Package'" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)SharpShader.CSharp.Frontend.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)SharpShader.CSharp.ShaderLib.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>


  <PropertyGroup><Version>$(StackPackageVersion)</Version><RepositoryUrl>https://github.com/haolange/SharpShader</RepositoryUrl></PropertyGroup>
  <PropertyGroup>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
  <!-- Roslyn resolves analyzer dependencies from the analyzer input set, including source project consumers. -->
  <Target Name="IncludeShaderGeneratorDependencies" AfterTargets="GetTargetPathWithTargetPlatformMoniker">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(TargetDir)SharpShader.CSharp.Frontend.dll;$(TargetDir)SharpShader.CSharp.ShaderLib.dll">
        <TargetFrameworkIdentifier>$(TargetFrameworkIdentifier)</TargetFrameworkIdentifier>
        <TargetFrameworkVersion>$(TargetFrameworkVersion)</TargetFrameworkVersion>
      </TargetPathWithTargetPlatformMoniker>
    </ItemGroup>
  </Target>
</Project>
