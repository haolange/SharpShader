<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(StackReferenceMode)' == 'Source'">
    <ProjectReference Include="../../src/SharpShader/SharpShader.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(StackReferenceMode)' == 'Package'">
    <PackageReference Include="SharpShader" Version="$(StackPackageVersion)" />
  </ItemGroup>
</Project>
